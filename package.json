{
  "name": "negs-zapolyarye",
  "version": "1.0.0",
  "description": "N.E.G.S: Заполярье — тактический 3D-шутер с реалистичной баллистикой (Three.js)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/game.js",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2020 --sourcemap --outfile=dist/game.js --servedir=. --watch",
    "serve": "python3 -m http.server 8080"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
